{
  "name": "@heyform/worker",
  "version": "1.0.0",
  "description": "HeyForm native Cloudflare Worker backend and edge server",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute heyform-db --local --file=./schema.sql",
    "db:migrate:prod": "wrangler d1 execute heyform-db --remote --file=./schema.sql",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "graphql": "^16.9.0",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.3",
    "wrangler": "^3.78.10"
  }
}
